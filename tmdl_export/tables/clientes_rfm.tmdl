				    clientes_rfm_Table = customer_analytics_Database{[Name="clientes_rfm",Kind="Table"]}[Data],
				    #"Orden segmento" = Table.AddColumn(clientes_rfm_Table, "orden_segmento", each if [segmento_rfm] = "Alto Valor" then 1 else if [segmento_rfm] = "Medio Valor" then 2 else if [segmento_rfm] = "Bajo Valor" then 3 else 4, Int64.Type)
